#!/usr/bin/env python3
import math
import time

import rclpy
from rclpy.node import Node

from geometry_msgs.msg import Twist
from nav_msgs.msg import Odometry
from geometry_msgs.msg import Quaternion

import pybullet as p
import pybullet_data


class PyBulletRos2Sim(Node):
    def __init__(self):
        super().__init__('pybullet_ros2_sim_node')

        # Subscribe /cmd_vel
        self.cmd_vel_sub = self.create_subscription(
            Twist, '/cmd_vel', self.cmd_vel_callback, 10
        )

        # Publish /odom
        self.odom_pub = self.create_publisher(Odometry, '/odom', 10)

        # PyBullet init
        self.physics_client = p.connect(p.GUI)  # 改成 p.DIRECT 可无GUI运行
        p.setAdditionalSearchPath(pybullet_data.getDataPath())
        p.setGravity(0, 0, -9.8)

        # Load world + robot
        self.plane_id = p.loadURDF("plane.urdf")
        self.car_id = p.loadURDF(
            "racecar/racecar.urdf",
            [0, 0, 0.1],
            p.getQuaternionFromEuler([0, 0, 0])
        )

        # Command state
        self.linear_x = 0.0
        self.angular_z = 0.0

        # Timer (240 Hz)
        self.dt = 1.0 / 240.0
        self.timer = self.create_timer(self.dt, self.simulation_loop)

        self.get_logger().info("PyBullet-ROS2 sim node started.")

    def cmd_vel_callback(self, msg: Twist):
        self.linear_x = float(msg.linear.x)
        self.angular_z = float(msg.angular.z)

    def simulation_loop(self):
        # Differential drive -> wheel speeds (very approximate for racecar model)
        wheel_base = 0.30
        wheel_radius = 0.05

        left_wheel_vel = (self.linear_x - self.angular_z * wheel_base / 2.0) / wheel_radius
        right_wheel_vel = (self.linear_x + self.angular_z * wheel_base / 2.0) / wheel_radius

        # racecar wheel joint indices (common in PyBullet racecar)
        wheel_joint_indices = [2, 3, 4, 5]  # LF, RF, LR, RR (may vary by URDF)

        for i, joint_idx in enumerate(wheel_joint_indices):
            target = left_wheel_vel if i in (0, 2) else right_wheel_vel
            p.setJointMotorControl2(
                bodyUniqueId=self.car_id,
                jointIndex=joint_idx,
                controlMode=p.VELOCITY_CONTROL,
                targetVelocity=target,
                force=10.0
            )

        # step simulation
        p.stepSimulation()

        # publish odom from base pose
        pos, orn = p.getBasePositionAndOrientation(self.car_id)
        now = self.get_clock().now().to_msg()

        odom = Odometry()
        odom.header.stamp = now
        odom.header.frame_id = "odom"
        odom.child_frame_id = "base_link"

        odom.pose.pose.position.x = float(pos[0])
        odom.pose.pose.position.y = float(pos[1])
        odom.pose.pose.position.z = float(pos[2])

        # PyBullet quaternion is (x, y, z, w)
        q = Quaternion()
        q.x = float(orn[0])
        q.y = float(orn[1])
        q.z = float(orn[2])
        q.w = float(orn[3])
        odom.pose.pose.orientation = q

        # 可选：把cmd_vel填到twist里（不是严格真实速度）
        odom.twist.twist.linear.x = self.linear_x
        odom.twist.twist.angular.z = self.angular_z

        self.odom_pub.publish(odom)

        # If GUI, slow down to real-time-ish (optional)
        # time.sleep(self.dt)


def main(args=None):
    rclpy.init(args=args)
    node = PyBulletRos2Sim()
    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    finally:
        try:
            p.disconnect()
        except Exception:
            pass
        node.destroy_node()
        rclpy.shutdown()


if __name__ == "__main__":
    main()
